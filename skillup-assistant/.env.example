# --- Server ---
PORT=3002
NODE_ENV=development
# Browser origin(s) allowed by CORS, comma-separated. Leave empty when only
# Spring Boot (server-to-server) calls this service: CORS is then disabled.
FRONTEND_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of this service whose X-Forwarded-For is
# trusted (used for per-client rate limiting). 0 = trust none.
TRUST_PROXY=0

# --- Lyzr (documented: POST {base}/inference/chat/ with x-api-key header) ---
LYZR_API_KEY=replace_with_your_lyzr_api_key
LYZR_AGENT_ID=6ae2408066278b21e1ccd018
LYZR_API_BASE_URL=https://agent-prod.studio.lyzr.ai/v3
# Lyzr requires a user_id on every call; this is a fixed, non-personal label.
LYZR_USER_ID=skillup-web-visitor

# --- OpenRouter (LLM for personalized assessment voice feedback) ---
# Sign up at https://openrouter.ai and obtain an API key.
# Recommended models: meta-llama/llama-3.3-70b-instruct, google/gemini-2.5-flash, openai/gpt-4o-mini
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Text-to-Speech (TTS) Provider Configuration ---
# Supported providers:
# - google-translate : FREE, zero credentials needed, uses Google's public TTS endpoint.
# - openai           : High-quality TTS via OpenAI API ($0.015 / 1k chars). Requires OPENAI_API_KEY.
# - elevenlabs       : Ultra-realistic neural voice. Requires ELEVENLABS_API_KEY & ELEVENLABS_VOICE_ID.
# - mock             : Generates mock MP3 audio frames for unit testing and offline development.
TTS_PROVIDER=google-translate

# OpenAI TTS settings (used when TTS_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# ElevenLabs TTS settings (used when TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Temporary audio cache TTL in milliseconds (default: 15 minutes = 900000 ms)
AUDIO_CACHE_TTL_MS=900000

# --- Internal service auth (Spring Boot -> this service) ---
# Optional but recommended. When set (min 16 chars), every /api/assistant/*
# request must send the header "x-internal-api-key: <this value>".
INTERNAL_API_KEY=

# --- Limits ---
REQUEST_TIMEOUT_MS=30000
MAX_MESSAGE_LENGTH=4000
REQUEST_BODY_LIMIT=16kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
