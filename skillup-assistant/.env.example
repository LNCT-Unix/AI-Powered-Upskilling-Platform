# --- Server ---
PORT=3002
NODE_ENV=development
# Browser origin(s) allowed by CORS, comma-separated. Leave empty when only
# Spring Boot (server-to-server) calls this service: CORS is then disabled.
FRONTEND_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of this service whose X-Forwarded-For is
# trusted (used for per-client rate limiting). 0 = trust none.
TRUST_PROXY=0

# --- Groq (LLM for conversational AI chatbot & assessment feedback) ---
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Internal service auth (Spring Boot -> this service) ---
# Optional but recommended. When set (min 16 chars), every /api/assistant/*
# request must send the header "x-internal-api-key: <this value>".
INTERNAL_API_KEY=

# --- Limits ---
REQUEST_TIMEOUT_MS=30000
MAX_MESSAGE_LENGTH=4000
REQUEST_BODY_LIMIT=16kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
