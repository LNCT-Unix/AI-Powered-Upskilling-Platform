# AI-Powered Upskilling Platform — Frontend Environment Configuration

# Backend Spring Boot Gateway URL
# Local Development: http://localhost:8080
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8080

# Mock Authentication & Offline Resilience:
# - Local Development & Offline Demos: Set to 'true'
# - Production Deployments: MUST be 'false' or unset to use real Spring Boot gateway
VITE_USE_MOCK_AUTH=false
VITE_USE_MOCK_DATA=false
