# AI-Powered Upskilling Platform — Frontend Environment Example
# Target Gateway: Spring Boot 3.x

# Backend Spring Boot Gateway URL
# ------------------------------------------------------------------------------
# 1. Local Development:
# VITE_API_BASE_URL=http://localhost:8080
# VITE_ASSISTANT_API_URL=http://localhost:3002
#
# 2. Cloudflare Testing:
# VITE_API_BASE_URL=https://msg-admission-opens-offerings.trycloudflare.com
# VITE_ASSISTANT_API_URL=https://gst-gilbert-elder-seeking.trycloudflare.com
#
# 3. Production:
# VITE_API_BASE_URL=https://api.octobyte.space
# VITE_ASSISTANT_API_URL=https://assistant.octobyte.space
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_ASSISTANT_API_URL=http://localhost:3002

# Optional: Mobile API URL (for native mobile Capacitor build)
# VITE_MOBILE_API_BASE_URL=http://10.71.104.22:8080

# Mock Authentication & Offline Resilience
# Set to false to connect to live Spring Boot Gateway
VITE_USE_MOCK_AUTH=false
VITE_USE_MOCK_DATA=false
