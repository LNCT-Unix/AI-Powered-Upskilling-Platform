
# AI-Powered Upskilling Platform — Frontend Environment Configuration
# Target Gateway: Spring Boot 3.x

# Backend Spring Boot Gateway URL
# Local Development: http://localhost:8080
# Production: Your deployed Spring Boot Cloudflare/domain URL
VITE_API_BASE_URL=http://localhost:8080

# Optional: Mobile API URL (for native mobile Capacitor build)
# VITE_MOBILE_API_BASE_URL=http://10.71.104.22:8080

# AI Assistant & Voice Companion Service URL (skillup-assistant)
# Local Development: http://localhost:3002
# Note: Keep this only if the frontend directly calls the Node.js service.
VITE_ASSISTANT_API_URL=http://localhost:3002

# Mock Authentication & Offline Resilience
# Set to false to connect to live Spring Boot Gateway
VITE_USE_MOCK_AUTH=false
VITE_USE_MOCK_DATA=false

