# ==============================================================================
# AI-Powered Upskilling Platform - Backend Environment Example
# ==============================================================================

# Database Configuration (Neon Cloud PostgreSQL or Local PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/upskilldb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-database-password

# Email / SMTP Configuration (Gmail SMTP)
APP_MAIL_FROM=your-email@gmail.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password

# Google OAuth 2.0 / OIDC
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Security & Tokens (min 32 characters)
APP_AUTH_JWT_SECRET=0123456789012345678901234567890123456789

# Frontend Redirects and Handshake Callback Routes:
# ------------------------------------------------------------------------------
# 1. Local Development:
# APP_FRONTEND_WEB_CALLBACK_URL=http://localhost:5173/auth/callback
# APP_FRONTEND_WEB_ERROR_URL=http://localhost:5173/auth/error
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
#
# 2. Cloudflare Testing:
# APP_FRONTEND_WEB_CALLBACK_URL=https://everyday-ties-wilderness-encoding.trycloudflare.com/auth/callback
# APP_FRONTEND_WEB_ERROR_URL=https://everyday-ties-wilderness-encoding.trycloudflare.com/auth/error
# APP_CORS_ALLOWED_ORIGINS=https://everyday-ties-wilderness-encoding.trycloudflare.com,http://localhost:5173,https://www.octobyte.space,https://octobyte.space
#
# 3. Production:
# APP_FRONTEND_WEB_CALLBACK_URL=https://www.octobyte.space/auth/callback
# APP_FRONTEND_WEB_ERROR_URL=https://www.octobyte.space/auth/error
# APP_CORS_ALLOWED_ORIGINS=https://www.octobyte.space,https://octobyte.space
# ------------------------------------------------------------------------------
APP_FRONTEND_WEB_CALLBACK_URL=http://localhost:5173/auth/callback
APP_FRONTEND_WEB_ERROR_URL=http://localhost:5173/auth/error
APP_FRONTEND_MOBILE_CALLBACK_URL=octobyte://auth/callback
APP_FRONTEND_MOBILE_ERROR_URL=octobyte://auth/error
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://www.octobyte.space,https://octobyte.space

# Assistant Service Configuration
# Local: http://localhost:3002
# Cloudflare: https://your-assistant-tunnel.trycloudflare.com
ASSISTANT_SERVICE_URL=http://localhost:3002
ASSISTANT_INTERNAL_API_KEY=your-assistant-internal-api-key
