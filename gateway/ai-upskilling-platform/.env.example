# pgAdmin login credentials
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-password

# ──────────────────────────────────────────────
# SMTP / Email Configuration (Gmail App Password)
# ──────────────────────────────────────────────
# Set these in your IDE run config or OS environment — never commit real values.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-gmail-address@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password
# Sender address shown in the "From" header (defaults to SPRING_MAIL_USERNAME if unset)
APP_MAIL_FROM=your-gmail-address@gmail.com
